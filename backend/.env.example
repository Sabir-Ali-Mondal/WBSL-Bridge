# WBSL Bridge — AI Provider Configuration
# Copy this file to .env and fill in your values.
# Works with ANY OpenAI-compatible API:
#   OpenAI, DeepSeek, Groq, OpenRouter, Ollama, LM Studio, KoboldCpp

# --- Cloud providers ---
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-key-here
# AI_MODEL_NAME=gpt-4o-mini

# --- DeepSeek ---
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=your-deepseek-key
# AI_MODEL_NAME=deepseek-chat

# --- Groq ---
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your-key
# AI_MODEL_NAME=llama-3.3-70b-versatile

# --- OpenRouter ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-your-key
# AI_MODEL_NAME=google/gemma-3-27b-it

# --- Local (Ollama) ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL_NAME=gemma3:27b

# --- Local (KoboldCpp) ---
# AI_BASE_URL=http://localhost:5001/v1
# AI_API_KEY=no-key-required
# AI_MODEL_NAME=gemma-4-E4B

# --- Options ---
AI_STREAM=true
AI_REASONING=true
AI_REASONING_EFFORT=low
AI_TIMEOUT=180