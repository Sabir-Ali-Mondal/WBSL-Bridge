# -----------------------------------------------------------------------------
# Secrets / environment  (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key


# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Project-local virtual environments
.venv/
.venv-*/
venv/
env/
ENV/
.conda/
pyvenv.cfg

# Local model assets that are required at runtime but too large for Git.
/models/emotion/

# Packaging / builds
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test & type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover
coverage.xml


# -----------------------------------------------------------------------------
# Model weights & binaries  (large — fetch/rebuild, do not commit)
# -----------------------------------------------------------------------------
# GGUF quantised LLMs + the koboldcpp runtime (~6.3 GB under models/llm/)
models/llm/
*.gguf

# ONNX graphs, external tensor data, and compiled model artifacts

*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.tflite
*.mlmodel
*.bin
*.pb

# Native binaries / shared libs shipped with models
*.exe
*.dll
*.dylib

# Local model download caches
.cache/
huggingface/
torch/
*.model


# -----------------------------------------------------------------------------
# Datasets & generated media  (large / regenerable — do not commit)
# -----------------------------------------------------------------------------
# Local contributor recordings
backend/data/community_dataset/manifest.jsonl
backend/data/community_dataset/samples/


/model_training_zone/dataset/
/model_training_zone/dataset_train/
backend/tts_output

# Generated TTS audio output (regenerated on every request)
backend/tts_output/*
!backend/tts_output/.gitkeep

# Common binary artifacts produced by training and capture pipelines.

*.wav
*.m4a
*.flac
*.pkl
*.npz
*.npy
*.hdf5
*.parquet
*.arrow
models/onnx_models

# -----------------------------------------------------------------------------
# Node / Next.js  (frontend has its own .gitignore too — this is a backstop
# for when the root repo is initialised over the whole tree)
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.next/
out/
.vercel
.turbo/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/


# -----------------------------------------------------------------------------
# Logs & runtime output
# -----------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
frontend_dev.log
frontend_dev.err.log


# -----------------------------------------------------------------------------
# Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/


# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*.suo
*.user
*~

# -----------------------------------------------------------------------------
# OS cruft
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------------------
# Scratch / temporary
# -----------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/
scratch/
frontend/.git-frontend-backup/
